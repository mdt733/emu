{"format":"emu-policy","schema":3,"created_by":"EMU v5015","source":{"checkpoint":"final.pkl","step":260046848,"run_name":"pinnacle_cold260","display_label":"pinnacle_cold260","seed":761,"checkpoint_schema":9,"version":"v5015","git_commit":"9b11bbe596aea7201d29a6beb2d192922f8e2e9a","robot_model_sha256":"c1af72485e83de277efa1914a476519cebbebdc2beb1f03a10c475c9fadf3a64","actor_sha256":"e268dfd500a4c2a63cee1b064d44f510db7488715f3f4eff32b4ac0e985e45f9"},"training":{"attitude_profile":"v5015","pitch_command_max_deg":8.0,"capability_field_mode":"shadow","field_max_influence":0.65,"field_teach_nodes":true,"field_teach_edges":true,"field_teach_recovery":true,"field_evidence_from_taught":true,"field_influence_start_steps":20000000,"field_influence_full_steps":30000000,"field_influence_fade_start_steps":0,"field_influence_zero_steps":0},"policy":{"obs_dim":360,"base_obs_dim":90,"history_len":4,"action_dim":6,"hidden_sizes":[256,256],"activation":"tanh","output":"deterministic_mean_clipped","layers":[{"w":{"dtype":"float32-le","shape":[360,256],"data_b64":""},"b":{"dtype":"float32-le","shape":[256],"data_b64":""}},{"w":{"dtype":"float32-le","shape":[256,256],"data_b64":""},"b":{"dtype":"float32-le","shape":[256],"data_b64":""}},{"w":{"dtype":"float32-le","shape":[256,6],"data_b64":""},"b":{"dtype":"float32-le","shape":[6],"data_b64":"poiLO4qYa7zqig49n451vbexzbyt3SM9"}}],"log_std":{"dtype":"float32-le","shape":[6],"data_b64":"728TwIKTE8DpfxPAV2wTwH+ZE8DnbxPA"},"std_clip":[0.1,0.6]},"observation":{"base_fields":["gravity_x","gravity_y","gravity_z","gyro_x","gyro_y","gyro_z","q_r_hip_roll","q_r_hip_pitch","q_r_knee","q_l_hip_roll","q_l_hip_pitch","q_l_knee","qv_r_hip_roll","qv_r_hip_pitch","qv_r_knee","qv_l_hip_roll","qv_l_hip_pitch","qv_l_knee","prev_action_r_hip_roll","prev_action_r_hip_pitch","prev_action_r_knee","prev_action_l_hip_roll","prev_action_l_hip_pitch","prev_action_l_knee","prev_ctrl_r_hip_roll","prev_ctrl_r_hip_pitch","prev_ctrl_r_knee","prev_ctrl_l_hip_roll","prev_ctrl_l_hip_pitch","prev_ctrl_l_knee","foot_r_x","foot_r_y","foot_r_z","foot_l_x","foot_l_y","foot_l_z","vel_x","vel_y","tof_height","vel_confidence","cmd_vx","cmd_vy","cmd_yaw","cmd_height","cmd_pitch","cmd_roll","cmd_step_height","phase_sin","phase_cos","shin_flex_r","shin_flex_l","shin_rate_r","shin_rate_l","shin_load_r","shin_load_l","ground_forward_grade_rad","ground_sideways_grade_rad","ground_visibility_confidence","tof4x4_range_00_m","tof4x4_range_01_m","tof4x4_range_02_m","tof4x4_range_03_m","tof4x4_range_10_m","tof4x4_range_11_m","tof4x4_range_12_m","tof4x4_range_13_m","tof4x4_range_20_m","tof4x4_range_21_m","tof4x4_range_22_m","tof4x4_range_23_m","tof4x4_range_30_m","tof4x4_range_31_m","tof4x4_range_32_m","tof4x4_range_33_m","tof4x4_valid_00","tof4x4_valid_01","tof4x4_valid_02","tof4x4_valid_03","tof4x4_valid_10","tof4x4_valid_11","tof4x4_valid_12","tof4x4_valid_13","tof4x4_valid_20","tof4x4_valid_21","tof4x4_valid_22","tof4x4_valid_23","tof4x4_valid_30","tof4x4_valid_31","tof4x4_valid_32","tof4x4_valid_33"],"sensor_contract":{"schema":"terrain_360","sensor_model_revision":"forward_tof4x4_array_plane_fit_no_tripod_2","base_fields":["gravity_x","gravity_y","gravity_z","gyro_x","gyro_y","gyro_z","q_r_hip_roll","q_r_hip_pitch","q_r_knee","q_l_hip_roll","q_l_hip_pitch","q_l_knee","qv_r_hip_roll","qv_r_hip_pitch","qv_r_knee","qv_l_hip_roll","qv_l_hip_pitch","qv_l_knee","prev_action_r_hip_roll","prev_action_r_hip_pitch","prev_action_r_knee","prev_action_l_hip_roll","prev_action_l_hip_pitch","prev_action_l_knee","prev_ctrl_r_hip_roll","prev_ctrl_r_hip_pitch","prev_ctrl_r_knee","prev_ctrl_l_hip_roll","prev_ctrl_l_hip_pitch","prev_ctrl_l_knee","foot_r_x","foot_r_y","foot_r_z","foot_l_x","foot_l_y","foot_l_z","vel_x","vel_y","tof_height","vel_confidence","cmd_vx","cmd_vy","cmd_yaw","cmd_height","cmd_pitch","cmd_roll","cmd_step_height","phase_sin","phase_cos","shin_flex_r","shin_flex_l","shin_rate_r","shin_rate_l","shin_load_r","shin_load_l","ground_forward_grade_rad","ground_sideways_grade_rad","ground_visibility_confidence","tof4x4_range_00_m","tof4x4_range_01_m","tof4x4_range_02_m","tof4x4_range_03_m","tof4x4_range_10_m","tof4x4_range_11_m","tof4x4_range_12_m","tof4x4_range_13_m","tof4x4_range_20_m","tof4x4_range_21_m","tof4x4_range_22_m","tof4x4_range_23_m","tof4x4_range_30_m","tof4x4_range_31_m","tof4x4_range_32_m","tof4x4_range_33_m","tof4x4_valid_00","tof4x4_valid_01","tof4x4_valid_02","tof4x4_valid_03","tof4x4_valid_10","tof4x4_valid_11","tof4x4_valid_12","tof4x4_valid_13","tof4x4_valid_20","tof4x4_valid_21","tof4x4_valid_22","tof4x4_valid_23","tof4x4_valid_30","tof4x4_valid_31","tof4x4_valid_32","tof4x4_valid_33"],"history_len":4,"action_dim":6,"control_dt":0.02,"settings":{"tof_period_frames":2,"flow_period_frames":1,"tof_delay_frames":1,"flow_delay_frames":1,"tof_dropout_prob":0.01,"flow_dropout_prob":0.02,"gyro_bias_std_rad_s":0.015,"sensor_noise_scale":1.5},"tof4x4_mount_body_m":[0.0,0.0,0.0],"tof4x4_pitch_from_horizontal_deg":[40.0,60.0,80.0,100.0],"tof4x4_yaw_deg":[-22.5,-7.5,7.5,22.5],"tof4x4_range_limits_m":[0.04,1.5],"tof4x4_occlusion":"nearest ray-sphere foot hit masks terrain return","tof4x4_validity":"one bit per cell, delayed, zero on dropout","array_ground_estimator":"weighted_4x4_plane_residual_8mm_v1","array_ground_max_fit_residual_m":0.008,"array_ground_min_valid_cells":6,"sha256":"ba2a43a9954b887544b91a0dab95124144da8e8e761feb3d9c9552ce8413e5a0"},"history_order":"oldest_to_newest","mean":{"dtype":"float32-le","shape":[360],"data_b64":""},"std":{"dtype":"float32-le","shape":[360],"data_b64":""},"normalize_mask":{"dtype":"float32-le","shape":[360],"data_b64":""}},"control":{"sim_dt":0.005,"control_substeps":4,"control_dt":0.02,"actuated_joints":["r_hip_roll","r_hip_pitch","r_knee","l_hip_roll","l_hip_pitch","l_knee"],"target_span_rad":[0.3799999952316284,0.47999998927116394,0.5799999833106995,0.3799999952316284,0.47999998927116394,0.5799999833106995],"one_control_frame_actuation_delay":true,"neutral_root_z_m":0.2584,"default_commands":{"vx":0.04,"vy":0.0,"yaw":0.0,"height":0.0,"pitch":0.0,"roll":0.0,"step_height":0.012,"phase_rate_hz":0.0,"sensor_scale":0.0},"phase_speed_gain":1.25,"velocity_i":{"ramp_s":0.4,"multiplier":1.0,"algorithm":"sensor_relative_shortfall_bounded_v1"},"phase_speed_reference_mps":0.6,"sensor_noise_scale":1.5,"phase_base_hz":1.025,"phase_rate_max_hz":2.6,"command_limits":{"vx_min":-0.438089653011945,"vx_max":0.6692002182147456,"vy_abs":0.3811639710417692,"yaw_abs":3.5,"pitch_abs_rad":0.13962634015954636,"height_abs_m":0.018,"roll_abs_rad":0.055,"step_height_min_m":0.008,"step_height_max_m":0.042}},"features":{"pitch_command_actor_channel":true,"pitch_tracking_trained":true,"note":"v5015: commanded chassis attitude is separated from whole-robot support geometry, with crouch-aware reward and structural tracking."},"robot_xml":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!--\n  robot.xml \u2014 EMU v3017 Clean Blob fast training model\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n  ~0.5 kg ball-foot biped, 6 actuated DoF, 2 passive mid-shin flex DoF.\n\n  Kinematic chain per leg:\n    torso \u2192 hip_roll \u2192 hip_pitch \u2192 knee \u2192 passive mid-shin flex \u2192 ball foot\n\n  Geometry:\n    thigh:  (0,0,0) \u2192 (-0.1202, 0, -0.1202)   \u2192 45\u00b0 down-and-back at q=0\n    shin:   (0,0,0) \u2192 (+0.1202, 0, -0.1202)   \u2192 45\u00b0 down-and-forward at q=0\n    foot:   sphere ball, r=0.018, one main contact point\n\n  Passive spring design:\n    The neutral \"< 45/90/45\" crouch is spring-supported enough to be recoverable,\n    but not passively stable on ball feet.  Springs make the first survival-walk\n    problem physically reasonable; the policy still has to step and correct.\n\n  Actuators:\n    Feetech STS3215-style joint-direct model (servo itself is internally geared).\n    Six actuated joints use forcerange = \u00b11.913 N\u00b7m, kp = 10 N\u00b7m/rad,\n    damping = 0.435 N\u00b7m\u00b7s/rad, armature = 0.012 kg\u00b7m\u00b2 and Coulomb\n    frictionloss = 0.08 N\u00b7m. Servo target speed/lag/safety is handled by\n    environment.py; the physical joint constants themselves live here.\n\n  Contact contract:\n    v3017 seed model deliberately makes the thin thigh/shin rods non-contacting\n    so early training cannot be dominated by blunt sentinel/proxy deaths.  Feet\n    remain the only contact geoms.  Non-foot geometry is still tracked through\n    a soft body-low diagnostic/penalty in environment.py, and a later validation\n    model should reintroduce stricter sentinel policing before hardware trust.\n-->\n\n<mujoco>\n  <compiler angle=\"degree\" />\n  <option timestep=\"0.005\" integrator=\"Euler\" gravity=\"0 0 -9.81\" />\n\n  <default>\n    <!--\n      Base joint defaults preserve the passive-shin model. The six motor joints\n      explicitly override armature/frictionloss below so robot.xml alone fully\n      defines the effective physics used by MJX.\n      damping=0.435 implements the STS3215 torque-speed slope; shin_flex joints\n      override damping to 0.08 for the passive carbon-shin compliance.\n    -->\n    <joint damping=\"0.435\" armature=\"0.006\" />\n    <geom friction=\"1.5 0.005 0.0001\" />\n  </default>\n\n  <worldbody>\n    <light name=\"light_top\" pos=\"0 0 2\" directional=\"true\" />\n\n    <geom name=\"floor\" type=\"plane\" size=\"5 5 0.05\" rgba=\"0.2 0.25 0.3 1\" />\n    <body name=\"torso\" pos=\"0 0 0.2584\">\n      <freejoint name=\"root\" />\n      <!-- v3017: torso mass is shifted 26 mm forward so the neutral < stance\n           has COM over/just ahead of the ball feet. v3002 had the leg rods\n           pulling COM behind the contact point, causing immediate backward falls. -->\n      <geom name=\"torso_box\" type=\"box\" size=\"0.05 0.09 0.025\" pos=\"0.026 0 0\" mass=\"0.30\"\n            rgba=\"0.8 0.1 0.1 1\" />\n      <site name=\"imu\" pos=\"0 0 0\" />\n\n      <!-- \u2550\u2550\u2550 RIGHT LEG \u2550\u2550\u2550 -->\n      <body name=\"r_hip\" pos=\"0 -0.08 0\">\n        <inertial mass=\"0.01\" pos=\"0 0 0\" diaginertia=\"1e-5 1e-5 1e-5\" />\n        <joint name=\"r_hip_roll\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"1 0 0\"\n               range=\"-25 25\" stiffness=\"2.0\" springref=\"0\" />\n        <body name=\"r_thigh\" pos=\"0 0 0\">\n          <!-- Spring-balanced crouch: | has zero spring, q=0 `<` supports ~1x weight, deep `=` ~2x weight. -->\n          <joint name=\"r_hip_pitch\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"0 1 0\"\n                 range=\"-50 50\" stiffness=\"0.480\" springref=\"-45\" />\n          <geom name=\"r_thigh_rod\" type=\"capsule\" size=\"0.008\"\n                fromto=\"0 0 0 -0.1202 0 -0.1202\" mass=\"0.04\"\n                contype=\"0\" conaffinity=\"0\" />\n          <body name=\"r_shin\" pos=\"-0.1202 0 -0.1202\">\n            <!-- Knee support for the neutral crouch; motors still do dynamic correction. -->\n            <joint name=\"r_knee\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"0 1 0\"\n                   range=\"-55 95\" stiffness=\"0.480\" springref=\"45\" />\n            <!-- Carbon shin compliance is modelled at the rod midpoint so the\n                 virtual flex angle has the same semantics as the magnet/Hall\n                 pair on the real shin. -->\n            <geom name=\"r_shin_upper\" type=\"capsule\" size=\"0.008\"\n                  fromto=\"0 0 0 0.0601 0 -0.0601\" mass=\"0.015\"\n                  contype=\"0\" conaffinity=\"0\" />\n            <body name=\"r_shin_lower\" pos=\"0.0601 0 -0.0601\">\n              <joint name=\"r_shin_flex\" type=\"hinge\" axis=\"0 1 0\" range=\"-10 10\"\n                     stiffness=\"4.0\" damping=\"0.08\" />\n              <geom name=\"r_shin_lower_rod\" type=\"capsule\" size=\"0.008\"\n                    fromto=\"0 0 0 0.0601 0 -0.0601\" mass=\"0.015\"\n                    contype=\"0\" conaffinity=\"0\" />\n              <body name=\"r_foot\" pos=\"0.0601 0 -0.0601\">\n                <geom name=\"r_foot_ball\" type=\"sphere\" size=\"0.018\" pos=\"0 0 0\"\n                      mass=\"0.010\" rgba=\"0.25 0.35 0.80 1\" />\n              </body>\n            </body>\n          </body>\n        </body>\n      </body>\n\n      <!-- \u2550\u2550\u2550 LEFT LEG \u2550\u2550\u2550 (mirror) -->\n      <body name=\"l_hip\" pos=\"0 0.08 0\">\n        <inertial mass=\"0.01\" pos=\"0 0 0\" diaginertia=\"1e-5 1e-5 1e-5\" />\n        <joint name=\"l_hip_roll\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"1 0 0\"\n               range=\"-25 25\" stiffness=\"2.0\" springref=\"0\" />\n        <body name=\"l_thigh\" pos=\"0 0 0\">\n          <joint name=\"l_hip_pitch\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"0 1 0\"\n                 range=\"-50 50\" stiffness=\"0.480\" springref=\"-45\" />\n          <geom name=\"l_thigh_rod\" type=\"capsule\" size=\"0.008\"\n                fromto=\"0 0 0 -0.1202 0 -0.1202\" mass=\"0.04\"\n                contype=\"0\" conaffinity=\"0\" />\n          <body name=\"l_shin\" pos=\"-0.1202 0 -0.1202\">\n            <joint name=\"l_knee\" type=\"hinge\" armature=\"0.012\" frictionloss=\"0.08\" axis=\"0 1 0\"\n                   range=\"-55 95\" stiffness=\"0.480\" springref=\"45\" />\n            <!-- Carbon shin compliance is modelled at the rod midpoint so the\n                 virtual flex angle has the same semantics as the magnet/Hall\n                 pair on the real shin. -->\n            <geom name=\"l_shin_upper\" type=\"capsule\" size=\"0.008\"\n                  fromto=\"0 0 0 0.0601 0 -0.0601\" mass=\"0.015\"\n                  contype=\"0\" conaffinity=\"0\" />\n            <body name=\"l_shin_lower\" pos=\"0.0601 0 -0.0601\">\n              <joint name=\"l_shin_flex\" type=\"hinge\" axis=\"0 1 0\" range=\"-10 10\"\n                     stiffness=\"4.0\" damping=\"0.08\" />\n              <geom name=\"l_shin_lower_rod\" type=\"capsule\" size=\"0.008\"\n                    fromto=\"0 0 0 0.0601 0 -0.0601\" mass=\"0.015\"\n                    contype=\"0\" conaffinity=\"0\" />\n              <body name=\"l_foot\" pos=\"0.0601 0 -0.0601\">\n                <geom name=\"l_foot_ball\" type=\"sphere\" size=\"0.018\" pos=\"0 0 0\"\n                      mass=\"0.010\" rgba=\"0.25 0.35 0.80 1\" />\n              </body>\n            </body>\n          </body>\n        </body>\n      </body>\n    </body>\n  </worldbody>\n\n  <!--\n    Position actuators \u2014 Feetech STS3215 @ 6V, direct at robot joint (servo has its own internal geartrain).\n\n    Physical specs:\n      Peak stall torque:  19.5 kg\u00b7cm = 1.913 N\u00b7m\n      Rated cont. torque:  6.5 kg\u00b7cm = 0.638 N\u00b7m\n      No-load speed:       60\u00b0/0.238s = 4.40 rad/s = 252 deg/s\n\n    Torque-speed curve simulation via joint damping:\n      A brushed/brushless servo has a roughly linear torque-speed relationship:\n        T(\u03c9) = T_stall \u2212 b \u00b7 \u03c9    where  b = T_stall / \u03c9_noload\n      b = 1.913 / 4.40 = 0.435 N\u00b7m\u00b7s/rad\n\n      This is implemented as joint damping in the <default> block (0.435).\n      The actuator forcerange is set to the STALL torque ceiling (\u00b11.913 N\u00b7m).\n      At any joint speed \u03c9, the effective output torque is:\n        T_eff = clip(kp\u00b7error, \u00b11.913) \u2212 0.435\u00b7\u03c9\n      which reproduces the torque-speed line:\n        \u03c9=0   \u2192 T_eff up to 1.913 N\u00b7m  (100% stall)  \u2713\n        \u03c9=2.93 \u2192 T_eff up to 0.638 N\u00b7m  (33%, rated)  \u2713\n        \u03c9=4.40 \u2192 T_eff \u2192 0             (no-load speed) \u2713\n\n    Effective joint dynamics (kp=10, armature=0.012 kg\u00b7m\u00b2):\n      \u03c9_n  = \u221a(kp/J)         = 28.9 rad/s = 4.6 Hz\n      \u03b6    = b/(2\u221a(kp\u00b7J))    = 0.628\n      Coulomb frictionloss   = 0.08 N\u00b7m\n      Saturation error       = 1.913/10 = 0.191 rad = 11\u00b0\n\n    vs old 2:1 geared MG996R:\n      Peak torque: 2.54 \u2192 1.913 N\u00b7m  (\u221225%)  compensated by springs in stance\n      Max speed:   2.62 \u2192 4.40 rad/s (+68%)   step frequency ceiling ~3.5 Hz\n      Backdrivability: poor \u2192 good              ground impacts absorbed as motion\n  -->\n  <actuator>\n    <position name=\"r_hip_roll\"  joint=\"r_hip_roll\"\n              kp=\"10\" ctrlrange=\"-25 25\"  forcerange=\"-1.913 1.913\" />\n    <position name=\"r_hip_pitch\" joint=\"r_hip_pitch\"\n              kp=\"10\" ctrlrange=\"-50 50\"  forcerange=\"-1.913 1.913\" />\n    <position name=\"r_knee\"      joint=\"r_knee\"\n              kp=\"10\" ctrlrange=\"-55 95\"  forcerange=\"-1.913 1.913\" />\n    <position name=\"l_hip_roll\"  joint=\"l_hip_roll\"\n              kp=\"10\" ctrlrange=\"-25 25\"  forcerange=\"-1.913 1.913\" />\n    <position name=\"l_hip_pitch\" joint=\"l_hip_pitch\"\n              kp=\"10\" ctrlrange=\"-50 50\"  forcerange=\"-1.913 1.913\" />\n    <position name=\"l_knee\"      joint=\"l_knee\"\n              kp=\"10\" ctrlrange=\"-55 95\"  forcerange=\"-1.913 1.913\" />\n  </actuator>\n\n  <!-- Thigh and shin rods are non-contacting in the fast seed model; feet are\n       the only contact geoms. Later hardware-validation models can reintroduce\n       explicit sentinel geoms without changing the training contact contract. -->\n\n  <sensor>\n    <accelerometer name=\"accel\" site=\"imu\" />\n    <gyro          name=\"gyro\"  site=\"imu\" />\n  </sensor>\n</mujoco>","demo":{"source":"training_capability_field","not_held_out":true,"node_candidates":[{"vx":-0.0024999999441206455,"vy":0.0,"yaw":-0.4166666567325592,"predicted":0.991,"effective_even
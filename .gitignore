# Python / virtual environments
.venv/
venv/
__pycache__/
*.py[cod]

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# EMU heavyweight training artefacts must never enter normal Git history.
# The normal ladder writes these OUTSIDE the repository to ../emu_runs/<VERSION>/.
**/checkpoints/
**/rung_runs/
*.pkl
*.npz
*.npy
*.log

# Common accidental local raw-output directories if somebody overrides paths.
/runs/
/raw_runs/
/local_runs/

# Curated research evidence lives in docs/RESEARCH_HISTORY.md; older raw results remain in Git history.

# Build and JS dependencies
/build/
*.egg-info/
**/node_modules/
**/dist/
/emu/webviewer_dist/
.pytest_cache/
*.emupolicy
# Tiny reproducible viewer fixtures are source/test inputs, not trained artefacts.
!/viewer/demo_zero.emupolicy
!/emu/viewer_src/demo_zero.emupolicy
/viewer/public/
/emu/viewer_src/public/
/showcase/preview/
!/showcase/champion.emupolicy

# v5018 one-off local measurement JSON generated in the checkout by early
# feasibility probes. Ignore, NEVER delete/move existing user results.
# Raw experiments should normally be written to ~/robot_lab/emu_exams/.
# Untracked raw JSON previously marked the source checkout "dirty" and
# blocked the reproducible cold-start emu train entrypoint.
/emu_v5018_batch_*.json
/v5018_p0a_spike*_results.json
